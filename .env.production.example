# JJboneTv 生产环境配置模板。
# 仅在生产服务器复制为 .env.production；条件允许时优先使用部署平台的
# 密钥管理服务。
# 启动命令：docker compose --env-file .env.production up --build -d

# 运行环境标识。禁止复用开发环境的数据库或 OSS Bucket。
APP_ENVIRONMENT=production

# PostgreSQL 配置。使用唯一的高强度密码，并在 DATABASE_URL 中进行 URL 编码。
POSTGRES_DB=thinktv
POSTGRES_USER=thinktv_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://thinktv_app:replace-with-a-strong-database-password@postgres:5432/thinktv
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2

# 旧版模型全局凭据。通常保持为空，因为用户会在 Studio 中按模型分组
# 配置自己的 API Key。
MODEL_API_BASE_URL=
MODEL_API_KEY=

# 用户认证和用户模型凭据加密。用户开始配置模型 API Key 后，必须保持
# 用户模型凭据加密密钥稳定。
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRE_MINUTES=1440
AUTH_COOKIE_SECURE=true
USER_MODEL_CREDENTIALS_SECRET=replace-with-a-separate-production-credentials-secret
# 默认 Compose 网络中只有固定地址的用户前端 Nginx 被信任。改变代理拓扑时
# 必须改成真实代理的精确 CIDR，禁止使用 0.0.0.0/0 或 ::/0。
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_TRUSTED_PROXY_CIDRS=172.30.0.10/32

# 生产环境生成资产使用私有 OSS Bucket。公网 Endpoint 用于签名下载；
# 内网 Endpoint 可选，供同地域阿里云 ECS 上传流量使用。
ASSET_STORAGE_BACKEND=oss
GENERATED_STORAGE_ROOT=/app/storage/generated
OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-your-region-internal.aliyuncs.com
OSS_BUCKET_NAME=replace-with-production-bucket
OSS_ACCESS_KEY_ID=replace-with-production-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-production-ram-access-key-secret
# 可选的 STS Token。使用 RAM AccessKey 对时保持为空。
OSS_SECURITY_TOKEN=
OSS_PREFIX=thinktv/generated
OSS_CNAME=false
OSS_SIGNED_URL_EXPIRE_SECONDS=3600

# 模型供应商响应、单资产和 Worker 租约边界。
PROVIDER_CONNECT_TIMEOUT_SECONDS=15
PROVIDER_READ_TIMEOUT_SECONDS=300
GENERATED_ASSET_MAX_BYTES=31457280
# 用户从画布上传的单张图片上限，默认 20 MiB。反向代理需预留 multipart 开销。
USER_IMAGE_UPLOAD_MAX_BYTES=20971520
# 单次生成任务全部前置图片的总大小上限，默认 100 MiB。
GENERATION_INPUT_IMAGES_MAX_TOTAL_BYTES=104857600
PROVIDER_RESPONSE_MAX_BYTES=50331648
PROVIDER_MAX_OUTPUTS=4
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_LEASE_SECONDS=90
GENERATION_HEARTBEAT_SECONDS=30
GENERATION_MAX_ATTEMPTS=3
IMAGE_ACTIVE_WINDOW=20
IMAGE_PROVIDER_CONCURRENCY=10
IMAGE_RESULT_CONCURRENCY=3
USER_IMAGE_ACTIVE_LIMIT=4
VIDEO_ACTIVE_LIMIT=10
VIDEO_SUBMIT_CONCURRENCY=4
VIDEO_POLL_CONCURRENCY=4
USER_VIDEO_ACTIVE_LIMIT=2
VIDEO_PROVIDER_TIMEOUT_SECONDS=3600
VIDEO_POLL_CONNECT_TIMEOUT_SECONDS=3
VIDEO_POLL_READ_TIMEOUT_SECONDS=10
PROVIDER_RETRY_MAX_ATTEMPTS=3
PROVIDER_RETRY_MAX_DELAY_SECONDS=60

# 用户端和管理端前端端口。Compose 仅绑定到服务器 127.0.0.1，
# 公网访问必须经过 deploy/nginx/thinktv.conf 中的外层 HTTPS Nginx。
FRONTEND_PORT=3001
ADMIN_FRONTEND_PORT=3002
APP_NETWORK_SUBNET=172.30.0.0/24
FRONTEND_PROXY_IP=172.30.0.10

# 管理员认证和初始账号。
ADMIN_JWT_SECRET=replace-with-a-different-production-admin-secret
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_COOKIE_SECURE=true
# 默认关闭 Bootstrap，关闭时邮箱和密码必须为空。仅首次初始化时临时改为
# true，设置有效邮箱和至少 16 位、包含大小写字母及数字的强密码；创建成功
# 后立即恢复 false 并清空下面两项。
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# 旧数据迁移归属配置。全新安装时保持为空。
THINKTV_LEGACY_OWNER_ID=
THINKTV_LEGACY_PROJECT_ID=
