# JJboneTv 开发环境配置模板。
# 复制为 .env.development 后填写密钥，真实配置禁止提交到版本库。
# 启动命令：docker compose --env-file .env.development up --build -d

# 运行环境标识。
APP_ENVIRONMENT=development

# 本地容器使用的 PostgreSQL 配置。
POSTGRES_DB=thinktv
POSTGRES_USER=thinktv
POSTGRES_PASSWORD=thinktv
DATABASE_URL=postgresql+psycopg://thinktv:thinktv@postgres:5432/thinktv

# 旧版模型全局凭据。通常保持为空，因为用户会在 Studio 中按模型分组
# 配置自己的 API Key。
MODEL_API_BASE_URL=
MODEL_API_KEY=

# 用户认证和用户模型凭据加密。
JWT_SECRET=replace-with-a-development-secret
JWT_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
USER_MODEL_CREDENTIALS_SECRET=replace-with-a-development-credentials-secret
# 只信任 Compose 中固定地址的用户前端 Nginx，不信任任意 X-Forwarded-For。
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_TRUSTED_PROXY_CIDRS=172.30.0.10/32

# 生成资产存储。开发 OSS 就绪前使用 local；切换到 oss 时必须配置下方
# 私有开发 Bucket 和 RAM 凭据。
ASSET_STORAGE_BACKEND=local
GENERATED_STORAGE_ROOT=/app/storage/generated
OSS_ENDPOINT=https://oss-cn-your-region.aliyuncs.com
OSS_INTERNAL_ENDPOINT=
OSS_BUCKET_NAME=replace-with-development-bucket
OSS_ACCESS_KEY_ID=replace-with-development-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-development-ram-access-key-secret
# 可选的 STS Token。使用 RAM AccessKey 对时保持为空。
OSS_SECURITY_TOKEN=
OSS_PREFIX=thinktv/generated
OSS_CNAME=false
OSS_SIGNED_URL_EXPIRE_SECONDS=3600

# 模型供应商响应、单资产和 Worker 租约边界。
PROVIDER_CONNECT_TIMEOUT_SECONDS=15
PROVIDER_READ_TIMEOUT_SECONDS=300
GENERATED_ASSET_MAX_BYTES=31457280
# 用户从画布上传的单张图片上限，默认 20 MiB。反向代理需预留 multipart 开销。
USER_IMAGE_UPLOAD_MAX_BYTES=20971520
# 单次生成任务全部前置图片的总大小上限，默认 100 MiB。
GENERATION_INPUT_IMAGES_MAX_TOTAL_BYTES=104857600
PROVIDER_RESPONSE_MAX_BYTES=50331648
PROVIDER_MAX_OUTPUTS=4
GENERATION_WORKER_POLL_SECONDS=1
GENERATION_LEASE_SECONDS=90
GENERATION_HEARTBEAT_SECONDS=30
GENERATION_MAX_ATTEMPTS=3

# 用户端和管理端前端端口。Compose 默认只监听本机回环地址。
FRONTEND_PORT=3001
ADMIN_FRONTEND_PORT=3002
APP_NETWORK_SUBNET=172.30.0.0/24
FRONTEND_PROXY_IP=172.30.0.10

# 管理员认证和初始账号。
ADMIN_JWT_SECRET=replace-with-a-development-admin-secret
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_COOKIE_SECURE=false
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_EMAIL=admin@thinktv.local
ADMIN_BOOTSTRAP_PASSWORD=AdminLocalPassword123

# 旧数据迁移归属配置。全新安装时保持为空。
THINKTV_LEGACY_OWNER_ID=
THINKTV_LEGACY_PROJECT_ID=
